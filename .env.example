# 這些是唯一需要在啟動前決定的設定。其餘（Meta App、PayUni、對外網址）都在後台「平台設定」頁填。
PORT=3000
DATABASE_PATH=./data/app.db

# ---- 以下皆為選填：有填會在第一次啟動時當作初始值寫入資料庫，之後以後台設定為準 ----
# 用環境變數建立第一位平台擁有者（不填的話，第一位從網頁註冊的人就是擁有者）
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=

# PUBLIC_URL=https://go.example.com
# APP_NAME=Lakeze Go
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v21.0
# PAYUNI_MER_ID=
# PAYUNI_HASH_KEY=
# PAYUNI_HASH_IV=
# PAYUNI_SANDBOX=1
# SESSION_SECRET=
