# 這些是唯一需要在啟動前決定的設定。其餘（Meta App、對外網址、密碼）都在後台「設定」頁填。
PORT=3000
DATABASE_PATH=./data/app.db

# ---- 以下皆為選填：有填會在第一次啟動時當作初始值寫入資料庫，之後以後台設定為準 ----
# ADMIN_PASSWORD=
# PUBLIC_URL=https://your-domain.example.com
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v21.0
# SESSION_SECRET=
